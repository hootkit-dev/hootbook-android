<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".HootbookApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="${coreAcceptanceCleartext}"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.HootbookCompose">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Hootbook.SplashScreen"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <!-- Screenshots, statements and exports shared to Hootbook open AI bookkeeping -->
            <intent-filter android:label="@string/ai_share_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Existing alias names are retained so upgrades preserve launcher shortcuts. -->
        <activity-alias
            android:name=".MainActivityOriginal"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_hootbook_white"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_hootbook_white_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.Hootbook.SplashScreen.hootbook.white">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAnarchy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_hootbook_cream"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_hootbook_cream_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.Hootbook.SplashScreen.hootbook.cream">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityZenith"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_hoot_white"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_hoot_white_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.Hootbook.SplashScreen.hoot.white">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityMonochrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_book_white"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_book_white_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.Hootbook.SplashScreen.book.white">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityComic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_hoot_cream"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_hoot_cream_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.Hootbook.SplashScreen.hoot.cream">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".MainActivityBookCream"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_book_cream"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_book_cream_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.Hootbook.SplashScreen.book.cream">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity
            android:name=".presentation.ui.screens.crash.CrashActivity"
            android:exported="false"
            android:theme="@style/Theme.HootbookCompose"
            android:process=":crash" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".receiver.ReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget: add button and quick templates -->
        <receiver
            android:name=".widget.QuickAddWidgetReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="@string/widget_quick_add_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <service
            android:name=".service.AddTransactionTileService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/add_transaction"
            android:icon="@drawable/ic_add_transaction"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.AddSubscriptionTileService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/add_subscription"
            android:icon="@drawable/ic_add_subscription"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".service.AddTransferTileService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/add_transfer"
            android:icon="@drawable/ic_transfer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
