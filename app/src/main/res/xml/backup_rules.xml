<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Core data moves only through explicit Core backups or ledger sync. -->
    <exclude domain="database" path="hootkit.sqlite" />
    <exclude domain="database" path="hootkit.sqlite-wal" />
    <exclude domain="database" path="hootkit.sqlite-shm" />
    <!-- Current Core files use noBackupFilesDir; reserve filesDir paths too. -->
    <exclude domain="file" path="hootkit-core/" />
</full-backup-content>
